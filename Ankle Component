#include <esp_now.h>
#include <WiFi.h>

// Built-in LED Pin (Most common is GPIO 2. Change to 8 or 21 if using an ESP32-C3/S3)
const int LED_PIN = 2; 

// Sonar Sensor Hardware Pins
const int trigPin = 13;
const int echoPin = 12;

bool previousStepState = false;

// TODO: REPLACE THESE HEX VALUES WITH YOUR ESP #1 REAL MAC ADDRESS
uint8_t receiverAddress[] = {0x5C, 0x01, 0x3B, 0xBF, 0x3A, 0x4C}; 

// Data packet structure. Matches ESP #1 layout perfectly.
typedef struct struct_message {
  bool step_taken;
} struct_message;

struct_message myData;
esp_now_peer_info_t peerInfo;

// Callback function to check if the transmission succeeded or failed
// Updated callback signature for modern ESP32 Arduino Core v3+
void OnDataSent(const wifi_tx_info_t *tx_info, esp_now_send_status_t status) {
  Serial.print("\r\nLast Packet Send Status:\t");
  
  if (status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("Delivery Success");
    digitalWrite(LED_PIN, HIGH); // Turn ON built-in LED on success
  } else {
    Serial.println("Delivery Fail");
    digitalWrite(LED_PIN, LOW);  // Turn OFF built-in LED on failure
  }
}


void setup() {
  Serial.begin(115200);
  
  pinMode(trigPin, OUTPUT); 
  pinMode(echoPin, INPUT); 
  pinMode(LED_PIN, OUTPUT); // Initialize the built-in LED pin as an output
  
  // Set device as a Wi-Fi Station
  WiFi.mode(WIFI_STA);

  // Initialize ESP-NOW wireless protocols
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  // Register the delivery status callback
  esp_now_register_send_cb(OnDataSent);
  
  // Register the receiver as a peer
  memcpy(peerInfo.peer_addr, receiverAddress, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    Serial.println("Failed to add peer");
    return;
  }
}
 
void loop() {
  // 1. Trigger the ultrasonic sensor pulse
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  // 2. Read the wave travel time back to the echo pin
  long duration = pulseIn(echoPin, HIGH);
  
  // 3. Compute the structural distance value in cm
  float distanceCm = duration * 0.034 / 2;
  
  bool currentStepState = (distanceCm < 10);

  if (currentStepState && !previousStepState) {
      myData.step_taken = true;      // only send one pulse
  }
  else {
      myData.step_taken = false;
  }

  previousStepState = currentStepState;

  // 4. Beam the data structure over-the-air to ESP #1
  esp_err_t result = esp_now_send(receiverAddress, (uint8_t *) &myData, sizeof(myData));
   
  if (result != ESP_OK) {
    Serial.println("Error initiating wireless send transmission");
  }
  
  // Broadcast frequency (150ms gives highly responsive tracking without flooding the airwaves)
  delay(150); 
}
