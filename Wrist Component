#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include "LittleFS.h"
#include <esp_now.h>
#include <WiFi.h>

int menuIndex = 0;
const int TOTAL_ITEMS = 3; // RUN, MODE, POWER OFF
const char* modes[] = {"Steady","Sync","Anti"};
int modeIndex = 0;

const int motorPin = 25;
bool isVibrating = false;
unsigned long motorStartTime = 0;
unsigned long motorDuration = 100;
bool onRun = false;
bool isPaused = false;

bool onSteady = true;

float accel = 0.0; //Updated accel
const float accel_thres = 5.0; //MUST be tailored to the runner
bool previousStepState = false;
bool step_taken = false;
unsigned long step1 = 0;
unsigned long step2 = 0;
unsigned long step3 = 0;
int numSteps = 0;

typedef struct struct_message {
  float accel; //must match what ESP2 sends
} struct_message;

struct_message incomingData;

String ramBuffer = "";
int eventCounter = 0;
unsigned long lastLogTime = 0;       //tracks beat
unsigned long lastStepLogTime = 0;   //tracks step

const int BUTTON_SELECT = 26;
const int BUTTON_DOWN = 27;
const int BUTTON_UP = 14;

// Track previous states
int lastUpState = HIGH;
int lastDownState = HIGH;
int lastSelectState = HIGH;

// Press flags
bool upPressed = false;
bool downPressed = false;
bool selectPressed = false;

// Initialize display (128x64, I2C address 0x3C)
Adafruit_SSD1306 display(128, 64, &Wire, -1);

// --- ESP-NOW INTERRUPT CALLBACK ---
// Triggers instantly over-the-air whenever ESP #2 sends a new sonar reading
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingDataRaw, int len) {
  memcpy(&incomingData, incomingDataRaw, sizeof(incomingData));
  accel = incomingData.accel;

  bool currentStepState = (accel > 0 && accel < accel_thres);

  Serial.print("accel (gx) = ");
  Serial.print(accel);

  if (currentStepState && !previousStepState) {
    step_taken = true;
    Serial.println("  <-- STEP");
  } else {
    Serial.println();
  }
  previousStepState = currentStepState;
}

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_SELECT, INPUT_PULLUP);
  pinMode(BUTTON_DOWN, INPUT_PULLUP);
  pinMode(BUTTON_UP, INPUT_PULLUP);
  pinMode(motorPin, OUTPUT);

  // Initialize Wireless Stack for ESP-NOW (Required)
  WiFi.mode(WIFI_STA);
  if (esp_now_init() != ESP_OK) {
    Serial.println(F("Error initializing ESP-NOW"));
  } else {
    esp_now_register_recv_cb(OnDataRecv);
  }

  // Initialize LittleFS Internal Flash Partition
  if (!LittleFS.begin(true)) {
    Serial.println(F("LittleFS Storage partition initialization failed"));
  }
  
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }

  // Welcome Screen
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println(F("Sync\nMachine"));
  display.display();
  delay(2000);
  drawMenu();
}

void loop() {
  readButtons();
  if (onRun) {
    runRunLogic();
  } else {
    runMenuLogic();
  }
}

void readButtons() {
  int upState = digitalRead(BUTTON_UP);
  int downState = digitalRead(BUTTON_DOWN);
  int selectState = digitalRead(BUTTON_SELECT);

  upPressed = false;
  downPressed = false;
  selectPressed = false;

  if (upState == LOW && lastUpState == HIGH) {
    upPressed = true;
    delay(50);
  }
  lastUpState = upState;

  if (downState == LOW && lastDownState == HIGH) {
    downPressed = true;
    delay(50);
  }
  lastDownState = downState;

  if (selectState == LOW && lastSelectState == HIGH) {
    selectPressed = true;
    delay(50);
  }
  lastSelectState = selectState;
}

void runMenuLogic() {
  bool menuChanged = false;
  if (upPressed) {
    menuIndex = (menuIndex - 1 + TOTAL_ITEMS) % TOTAL_ITEMS;
    menuChanged = true;
  }
  if (downPressed) {
    menuIndex = (menuIndex + 1) % TOTAL_ITEMS;
    menuChanged = true;
  }
  if (selectPressed) {
    executeSelection();
    if (!onRun) {
      drawMenu();
    }
  } else if (menuChanged) {
    drawMenu();
  }
}

void runRunLogic() {
  unsigned long currentMillis = millis();
  static unsigned long lastMetronomeTick = 0;
  static unsigned long lastDisplayUpdate = 0;
  static bool toggleBeat = false;
  float cadence = 175.0;
  if(!onSteady && numSteps == 3){

    float avgPeriod = (step3-step1)/2.0;

    cadence = 60000.0/avgPeriod;
  }

  if (selectPressed) {
    isPaused = !isPaused;
  }

  // --- EXIT AND EXTRACT DATA VIA USB ---
  if (downPressed) {
    analogWrite(motorPin, 0); // Stops motor from staying stuck on exit
    onRun = false;
    isPaused = false;
    
    // 1. Flush any leftover lines in RAM to the physical flash before dumping
    if (ramBuffer.length() > 0) {
      File logFile = LittleFS.open(CSV_FILE_PATH, FILE_APPEND);
      if (logFile) {
        logFile.print(ramBuffer);
        logFile.close();
      }
      ramBuffer = "";
      eventCounter = 0;
    }
    
    display.clearDisplay();
    display.setCursor(0,0);
    display.setTextSize(2);
    display.println("DUMPING\nDATA...");
    display.display();

    // 2. Dump the accumulated data history via USB serial line
    Serial.println("\n--- START OF RUN CSV ---");
    File readFile = LittleFS.open(CSV_FILE_PATH, FILE_READ);
    if (readFile) {
      while (readFile.available()) {
        Serial.write(readFile.read());
      }
      readFile.close();
      Serial.println("--- END OF RUN CSV ---");
      // Wipe internal log to leave memory fresh for your next workout
      LittleFS.remove(CSV_FILE_PATH);
      Serial.println("[INFO] Storage wiped and re-centered.");
    } else {
      Serial.println("No data logs found.");
    }
    delay(1500);
    drawMenu();
    return;
  }

  // --- 1a. BEAT LOGGING STREAM (Every 300ms) ---
  if (!isPaused && (currentMillis - lastLogTime >= 300)) {
    lastLogTime = currentMillis;
    ramBuffer += String(currentMillis) + ",BEAT,1\n"; 
    eventCounter++;
  }

  // --- 1b. STEP LOGGING (latched flag set in OnDataRecv) ---
  // Checks every 200ms whether a step edge was detected since the last check.
  if (!isPaused && (currentMillis - lastStepLogTime >= 200)) {
    lastStepLogTime = currentMillis;
    if (step_taken) {
      ramBuffer += String(currentMillis) + ",STEP,1\n";
      eventCounter++;
      step1 = step2;
      step2 = step3;
      step3 = currentMillis;

      if(numSteps < 3){
          numSteps++;
      }
      
      step_taken = false; // consumed - reset for the next edge
    }
  }

  // --- BATCH SAVE ACTIONS ---
  if (eventCounter >= 20) {
    File logFile = LittleFS.open(CSV_FILE_PATH, FILE_APPEND);
    if (logFile) {
      logFile.print(ramBuffer);
      logFile.close();
    }
    ramBuffer = "";
    eventCounter = 0;
  }

  // --- 2. METRONOME MOTOR TICKER ---
  if (!isPaused && (currentMillis - lastMetronomeTick >= (120.0 / cadence) * 1000)) {
    lastMetronomeTick = currentMillis;
    toggleBeat = !toggleBeat;

    if (modeIndex == 0) { // STEADY
      Serial.println("BEEP! (Steady)");
      triggerVibration(255, 150, currentMillis);
    } 
    else if (modeIndex == 1) { // SYNC
      if (toggleBeat) {
        Serial.println("HIGH BEEP! (Sync)");
        triggerVibration(255, 150, currentMillis);
      } else {
        Serial.println("low beep... (Sync)");
        triggerVibration(120, 150, currentMillis);
      }
    } 
    else if (modeIndex == 2) { // ANTI
      Serial.println("BEEP-BEEP! (Anti)");
      triggerVibration(255, 150, currentMillis);
    }
  }

  // --- 3. MOTOR TIMER SHUTOFF ---
  if (isVibrating && (currentMillis - motorStartTime >= motorDuration)) {
    analogWrite(motorPin, 0);
    isVibrating = false;
  }

  // --- 4. DISPLAY LIVE DATA ---
  if (currentMillis - lastDisplayUpdate >= 200) {
    lastDisplayUpdate = currentMillis;
    display.clearDisplay();
    display.setCursor(0, 0);
    display.setTextSize(2);
    if (isPaused) {
      display.println("PAUSED");
    } else {
      display.println("RUNNING..");
    }
    display.setTextSize(1);
    display.print("Mode: ");
    display.println(modes[modeIndex]);
    display.println("Target BPM: 120");
    display.print("Accel: ");
    display.print(accel, 1);
    display.println(" (m/s^2)");

    if (isPaused) {
      display.println("[SELECT] to Resume");
    } else {
      display.println("[SELECT] to Pause");
    }
    display.println("Press [DOWN] to Stop");
    display.display();
  }
}

void drawMenu() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  for (int i = 0; i < TOTAL_ITEMS; i++) {
    display.setCursor(20, i * 20);
    switch (i) {
      case 0: display.println("RUN"); break;
      case 1: display.println("MODE"); break;
      case 2: display.println("POWER OFF"); break;
    }
  }
  display.setCursor(0, menuIndex * 20);
  display.println(">");
  display.display();
}

void executeSelection() {
  display.clearDisplay();
  display.setCursor(0, 0);
  display.setTextSize(2);
  switch(menuIndex) {
    case 0:
      onRun = true;
      isPaused = false;
      step_taken = false;
      previousStepState = false;
      LittleFS.remove(CSV_FILE_PATH);
      {
        File file = LittleFS.open(CSV_FILE_PATH, FILE_WRITE);
        if (file) {
          file.println("Timestamp_ms,Event_Type,Value");
          file.close();
        }
      }
      display.print("STARTING...");
      display.display();
      delay(1000);
      break;
    case 1:
      changeMode();
      display.println("Changing\nMODE...");
      display.print("To: ");
      display.print(modes[modeIndex]);
      display.display();
      delay(1500);
      drawMenu();
      break;
    case 2:
      display.println("POWERING\nOFF...");
      display.display();
      display.ssd1306_command(SSD1306_DISPLAYOFF);
      while(1);
      break;
  }
}

void changeMode() {
  modeIndex = (modeIndex + 1) % 3;
  if(modeIndex == 1 || modeIndex == 2){onSteady=false;}
  else{onSteady=true;}
}

void triggerVibration(int strength, unsigned long duration, unsigned long now) {
  analogWrite(motorPin, strength);
  motorStartTime = now;
  motorDuration = duration;
  isVibrating = true;
}
